{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cottrellashley/tars-kb/schemas/memory.schema.json",
  "title": "Tars memory profile 1.0 records",
  "description": "Interchange shapes. Runtime validation also checks identities, references, revision hashes, time order, profile inventory and transaction consistency.",
  "oneOf": [
    {
      "$ref": "#/$defs/profile"
    },
    {
      "$ref": "#/$defs/concept"
    },
    {
      "$ref": "#/$defs/assertion"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 128
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "UTC-normalized RFC 3339 instant; leap seconds are rejected by profile 1.0.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "point": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "instant"
            },
            "value": {
              "$ref": "#/$defs/instant"
            },
            "source_value": {
              "type": "string"
            }
          },
          "not": {
            "required": [
              "time_zone"
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "date"
            },
            "value": {
              "type": "string",
              "format": "date"
            },
            "time_zone": {
              "type": "string",
              "description": "Known IANA timezone; absent means a calendar label with unknown zone."
            },
            "source_value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "temporal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "timeless"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "until"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "observed",
                "event"
              ]
            },
            "at": {
              "$ref": "#/$defs/point"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "until"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "from",
            "until"
          ],
          "properties": {
            "kind": {
              "const": "interval"
            },
            "from": {
              "$ref": "#/$defs/point"
            },
            "until": {
              "oneOf": [
                {
                  "$ref": "#/$defs/point"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "description"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "until"
                ]
              }
            ]
          }
        }
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "id",
        "concepts",
        "text",
        "basis",
        "temporal",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "definition",
            "observed",
            "reported",
            "decision",
            "requirement",
            "inferred"
          ]
        },
        "temporal": {
          "$ref": "#/$defs/temporal"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "review_after": {
          "$ref": "#/$defs/instant"
        },
        "cardinality": {
          "enum": [
            "single",
            "multi"
          ]
        },
        "subject": {},
        "predicate": {},
        "value": {},
        "scope": {},
        "assessment": {},
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "target"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "supports",
                  "disputes",
                  "related",
                  "reconfirms"
                ]
              },
              "target": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "required_features": {
          "type": "array",
          "maxItems": 0
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "recorded_at"
            ]
          },
          {
            "required": [
              "sequence"
            ]
          },
          {
            "required": [
              "revision"
            ]
          },
          {
            "required": [
              "source_snapshots"
            ]
          },
          {
            "required": [
              "retracted"
            ]
          }
        ]
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "revision",
        "sequence",
        "recorded_at",
        "mode",
        "content",
        "source_snapshots",
        "retracted"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "$ref": "#/$defs/instant"
        },
        "mode": {
          "enum": [
            "assert",
            "correct",
            "change",
            "reconfirm",
            "retract"
          ]
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "retracted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "correct",
                  "retract"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "id",
        "revisions"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "profile": {
          "const": "tars-memory/1.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "revisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/revision"
          }
        },
        "required_features": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "concept": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "id",
        "title",
        "summary",
        "aliases",
        "parents",
        "related",
        "pages",
        "created_at",
        "sequence",
        "revision"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "profile": {
          "const": "tars-memory/1.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "created_at": {
          "$ref": "#/$defs/instant"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_features": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "schema_version",
        "profile",
        "sequence",
        "created_at",
        "history_started_at",
        "last_recorded_at",
        "concepts",
        "assertions",
        "transactions",
        "idempotency"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "profile": {
          "const": "tars-memory/1.0"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "$ref": "#/$defs/instant"
        },
        "history_started_at": {
          "$ref": "#/$defs/instant"
        },
        "last_recorded_at": {
          "$ref": "#/$defs/instant"
        },
        "concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "assertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "transactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "recorded_at",
              "previous_recorded_at",
              "clock_regressed",
              "operation_digest",
              "results"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "recorded_at": {
                "$ref": "#/$defs/instant"
              },
              "previous_recorded_at": {
                "$ref": "#/$defs/instant"
              },
              "clock_regressed": {
                "type": "boolean"
              },
              "operation_digest": {
                "type": "string"
              },
              "results": {
                "type": "array"
              }
            }
          }
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "digest",
              "receipt"
            ]
          }
        },
        "required_features": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "uri",
        "checked_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "workspace",
            "repository",
            "official",
            "conversation",
            "observation"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
