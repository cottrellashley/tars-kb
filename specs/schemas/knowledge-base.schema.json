{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tars:kb:knowledge-base:1.0",
  "title": "Tars knowledge base manifest 1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "summary",
    "version",
    "visibility",
    "owner",
    "language",
    "created_at",
    "updated_at",
    "entrypoint",
    "pages",
    "sources",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "visibility": {
      "enum": [
        "private",
        "shareable"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path",
          "kind",
          "status",
          "sources",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^pages/.+\\.md$"
          },
          "kind": {
            "enum": [
              "overview",
              "concept",
              "reference",
              "procedure",
              "decision",
              "status"
            ]
          },
          "status": {
            "enum": [
              "documented",
              "implemented",
              "observed",
              "proposed",
              "pending"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "uri",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "workspace",
              "repository",
              "official",
              "conversation",
              "observation"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "media_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:data/.+\\.json|assets/.+)$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
